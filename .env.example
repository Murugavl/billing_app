# App Configuration & Secret Credentials
# Copy this file to .env and fill in your values. Never commit .env to version control.
APP_NAME=Rasidhu
APP_ENV=production
APP_VERSION=1.0.0

# Business Profile Defaults (Override in App Settings)
DEFAULT_BUSINESS_NAME=Your Business Name
DEFAULT_PHONE=1234567890
DEFAULT_EMAIL=your@email.com
DEFAULT_STATE=Tamil Nadu

# Database Secret Salt / Key
# Change this to a strong random string for your own deployment
DB_SECRET_SALT=YourRandomSecretSaltHere
